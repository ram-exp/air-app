# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API → Project URL / anon public key). Once these are
# set and you restart `npm run dev`, the app auto-detects them and switches
# from local mode to real Supabase (Auth + Postgres + Storage) — no code
# changes needed. Don't forget to also run supabase.sql in the SQL Editor
# and create a public "uploads" Storage bucket — see README.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
